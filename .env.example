# Postgres (optional: without it the game runs, but nothing is persisted)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/partygame

# Steam Web API key (https://steamcommunity.com/dev/apikey) — server-side only, needed for Steam linking
STEAM_API_KEY=

# Where browsers reach the game server. Leave empty to use <same host>:4000 (works on a LAN).
NEXT_PUBLIC_SERVER_URL=
# Public URL of the game server (used in docs/compose)
PUBLIC_SERVER_URL=http://localhost:4000

# Game server
PORT=4000
# Comma-separated allowed browser origins for Socket.IO (empty = allow all, fine for dev)
WEB_ORIGINS=
# Fixed RNG seed for reproducible games (tests)
GAME_SEED=
