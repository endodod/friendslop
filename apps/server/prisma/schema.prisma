// Persistent data only. Live room state lives in memory (see src/rooms/roomStore.ts).
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id             String          @id @default(cuid())
  token          String          @unique // anonymous id kept in the browser's localStorage
  displayName    String
  createdAt      DateTime        @default(now())
  linkedAccounts LinkedAccount[]
  matchPlayers   MatchPlayer[]
  wonMatches     Match[]         @relation("MatchWinner")
}

model LinkedAccount {
  id          String         @id @default(cuid())
  profileId   String
  profile     Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  provider    String // "steam" | "lastfm" | "spotify"
  externalId  String
  displayName String
  avatarUrl   String?
  linkedAt    DateTime       @default(now())
  snapshots   DataSnapshot[]

  @@unique([profileId, provider])
}

model DataSnapshot {
  id              String        @id @default(cuid())
  linkedAccountId String
  linkedAccount   LinkedAccount @relation(fields: [linkedAccountId], references: [id], onDelete: Cascade)
  provider        String
  payload         Json
  fetchedAt       DateTime      @default(now())

  @@index([linkedAccountId, fetchedAt])
}

model Match {
  id              String        @id @default(cuid())
  roomCode        String
  startedAt       DateTime
  endedAt         DateTime?
  settings        Json
  winnerProfileId String?
  winner          Profile?      @relation("MatchWinner", fields: [winnerProfileId], references: [id], onDelete: SetNull)
  players         MatchPlayer[]
}

model MatchPlayer {
  id        String  @id @default(cuid())
  matchId   String
  match     Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  stars     Int
  coins     Int
  stats     Json
}

model QuestionStat {
  questionId   String   @id
  timesAsked   Int      @default(0)
  timesMatched Int      @default(0)
  guesses      Int      @default(0)
  matchRate    Float    @default(0)
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// User accounts (optional sign-in). Anonymous play keeps working without one.
// ---------------------------------------------------------------------------
model User {
  id             String       @id @default(cuid())
  username       String
  /// lower-cased username for case-insensitive uniqueness and lookups
  usernameKey    String       @unique
  passwordHash   String
  /// Custom profile picture (small, resized client-side). Null = use the icon picker.
  avatarData     Bytes?
  avatarMime     String?
  /// Bumped on every upload so the picture URL changes (cache busting).
  avatarVersion  Int          @default(0)
  gamesPlayed    Int          @default(0)
  gamesWon       Int          @default(0)
  starsCollected Int          @default(0)
  createdAt      DateTime     @default(now())
  sessions       Session[]
  questions      SavedQuestion[]
  gameStats      UserGameStat[]
  sentFriends    Friendship[] @relation("FriendRequester")
  gotFriends     Friendship[] @relation("FriendAddressee")
}

model Session {
  /// sha256 of the bearer token; the token itself is never stored
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

/// One row per pair. status "pending" until the addressee accepts.
model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  requester   User     @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User     @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      String   @default("pending") // "pending" | "accepted"
  createdAt   DateTime @default(now())

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

/// A custom question saved on a profile, loadable into any lobby.
model SavedQuestion {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// lower-cased, whitespace-collapsed prompt (no duplicates per user)
  promptKey String
  /// CustomQuestionDraft as the lobby editor sends it
  draft     Json
  createdAt DateTime @default(now())

  @@unique([userId, promptKey])
}

/// Games played and won per hub game ("party", "spygrid", "spectrum", "bluff"). User.gamesPlayed/gamesWon are the totals.
model UserGameStat {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId String
  played Int    @default(0)
  won    Int    @default(0)

  @@id([userId, gameId])
}
