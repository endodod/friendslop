    { "id": "charity", "name": "Charity", "description": "Last place gets 3 coins.", "icon": "charity", "effect": "giveLastPlace", "params": { "amount": 3 }},
    { "id": "coin-rain", "name": "Coin Rain", "description": "Everyone gets 2 coins.", "icon": "coin-rain", "effect": "everyoneCoins", "params": { "amount": 2 }},
    { "id": "drain", "name": "Down the Drain", "description": "Lose 5 coins.", "icon": "drain", "effect": "loseCoins", "params": { "amount": 5 }, "negative": true },
