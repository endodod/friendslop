{
  "id": "core-internet",
  "name": "Internet & Phones",
  "language": "en",
  "version": 1,
  "questions": [
    {
      "id": "net.apps",
      "themes": [
        "internet"
      ],
      "format": "number",
      "prompt": "How many apps are on {target}'s phone?",
      "number": {
        "min": 10,
        "max": 300,
        "step": 1,
        "tolerance": {
          "type": "relative",
          "value": 0.3
        },
        "unit": "apps"
      },
      "usage": [
        "tile",
        "questionOnlyMinigame"
      ]
    },
    {
      "id": "net.firstapp",
      "themes": [
        "internet"
      ],
      "format": "tiles",
      "prompt": "{target} unlocks their phone. First app they open?",
      "answers": [
        "Instagram",
        "TikTok",
        "WhatsApp",
        "YouTube"
      ],
      "usage": [
        "tile",
        "minigameIntro",
        "questionOnlyMinigame"
      ]
    },
    {
      "id": "net.unread",
      "themes": [
        "internet"
      ],
      "format": "number",
      "prompt": "How many unread messages does {target} have right now?",
      "number": {
        "min": 0,
        "max": 999,
        "step": 1,
        "tolerance": {
          "type": "relative",
          "value": 0.4
        },
        "unit": "messages"
      },
      "usage": [
        "tile",
        "questionOnlyMinigame"
      ]
    },
    {
      "id": "net.search",
      "themes": [
        "internet"
      ],
      "format": "tiles",
      "prompt": "{target}'s search history leaks. Most embarrassing search?",
      "answers": [
        "How to boil an egg",
        "Am I a good person quiz",
        "Their own name",
        "Cheat codes for a kids' game"
      ],
      "usage": [
        "tile",
        "minigameIntro",
        "questionOnlyMinigame"
      ]
    },
    {
      "id": "net.addicted",
      "themes": [
        "internet"
      ],
      "format": "scale",
      "prompt": "How addicted is {target} to their phone, 1–10?",
      "number": {
        "min": 1,
        "max": 10,
        "step": 1,
        "tolerance": {
          "type": "absolute",
          "value": 1
        }
      },
      "scaleLabels": {
        "min": "could throw it in a lake",
        "max": "the phone is a body part"
      },
      "usage": [
        "tile",
        "minigameIntro",
        "questionOnlyMinigame"
      ]
    },
    {
      "id": "net.lockscreen",
      "themes": [
        "internet"
      ],
      "format": "tiles",
