        "The default wallpaper",
        "Someone they love"
      ],
      "usage": [
        "tile",
        "minigameIntro",
        "questionOnlyMinigame"
      ]
    },
    {
      "id": "net.checks",
      "themes": [
        "internet"
      ],
      "format": "higherLower",
      "prompt": "{target} checks their phone 80 times a day. Higher or lower?",
      "number": {
        "min": 0,
        "max": 400,
        "step": 10,
        "tolerance": {
          "type": "absolute",
          "value": 0
        },
        "unit": "times"
      },
      "reference": 80,
      "usage": [
        "tile",
        "minigameIntro",
        "questionOnlyMinigame"
      ]
    },
